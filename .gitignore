# Environment files — never commit real secrets.
# .env.example is the only one that may be checked in.
.env
.env.local
.env*.local
.env.development
.env.production
!.env.example
# Wrangler's local secrets file — same rule as .env.local.
.dev.vars
.dev.vars.*
!.dev.vars.example

