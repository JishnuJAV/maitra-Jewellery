# =============================================================================
# Maitra Jewellery — environment configuration
#
# Copy this file to `.env.local` and fill in the real values.
# NEVER commit a file containing real secrets. Only NEXT_PUBLIC_* variables are
# sent to the browser; everything else stays on the server.
# =============================================================================

# -----------------------------------------------------------------------------
# Database — Supabase Postgres
# Supabase dashboard → Project Settings → Database → Connection string
# -----------------------------------------------------------------------------
# Pooled connection (Transaction mode, port 6543). Used by the running app.
# The ?pgbouncer=true flag is required so Prisma disables prepared statements.
DATABASE_URL="postgresql://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Direct connection (Session mode, port 5432). Used only by `prisma migrate`.
DIRECT_URL="postgresql://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# -----------------------------------------------------------------------------
# Session security
# Generate each of these with:  openssl rand -base64 48
# -----------------------------------------------------------------------------
# Signs admin + customer session JWTs. Rotating it logs everyone out.
AUTH_SECRET="CHANGE_ME_generate_a_long_random_string"
# Salt used to hash visitor IPs for analytics, so raw IPs are never stored.
ANALYTICS_SALT="CHANGE_ME_generate_a_different_random_string"

# -----------------------------------------------------------------------------
# Admin account — seeded into the database by `npm run seed`
# The password is bcrypt-hashed before storage; the plaintext lives only here.
# Change ADMIN_PASSWORD and re-run the seed to rotate it.
# -----------------------------------------------------------------------------
ADMIN_USERNAME="maitra@admin"
# Never put the real password in this file — .env.example IS committed to Git.
# Set the real one in .env.local (local) and as a Cloudflare secret (deployed),
# then run `npm run seed` to create/rotate the account.
ADMIN_PASSWORD=""

# -----------------------------------------------------------------------------
# Cloudinary — product images and videos
# Dashboard → Settings → API Keys
# -----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Cloud name is also needed in the browser to build delivery URLs.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""

# -----------------------------------------------------------------------------
# OTP delivery — SMS
# Leave OTP_PROVIDER=console during development: the code is printed to the
# server console (and returned in the API response) instead of being sent.
# Switch to msg91 or fast2sms once your DLT sender-ID and template are approved.
# -----------------------------------------------------------------------------
OTP_PROVIDER="console"          # console | msg91 | fast2sms

# MSG91 (https://msg91.com) — required when OTP_PROVIDER=msg91
MSG91_AUTH_KEY=""
MSG91_TEMPLATE_ID=""            # DLT-approved template containing ##OTP##
MSG91_SENDER_ID=""              # 6-character DLT-approved sender ID, e.g. MAITRA

# Fast2SMS (https://fast2sms.com) — required when OTP_PROVIDER=fast2sms
FAST2SMS_API_KEY=""
FAST2SMS_SENDER_ID=""
FAST2SMS_MESSAGE_ID=""

# -----------------------------------------------------------------------------
# Public site config
# -----------------------------------------------------------------------------
# Your real public domain. Inlined at BUILD time, so on Cloudflare set it as a
# build variable (not a secret). Missing here = wrong canonical + share-preview
# links on every page.
NEXT_PUBLIC_SITE_URL="https://maitrajewellery.maitrajewellery.workers.dev"

# Cloudflare image resizing. Only works on a CUSTOM DOMAIN with
# Images -> Transformations enabled — NOT on localhost and NOT on *.workers.dev.
# Leave false until you attach a real domain, or every /public image 404s.
# Build-time variable, not a runtime secret.
NEXT_PUBLIC_CF_IMAGE_TRANSFORMS="false"
