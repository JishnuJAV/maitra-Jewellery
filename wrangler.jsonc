{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "maitrajewellery",
  "main": ".open-next/worker.js",

  // Must be 2024-09-23 or later for @opennextjs/cloudflare.
  "compatibility_date": "2025-03-25",
  "compatibility_flags": [
    // Required. Provides node:crypto (used by the OTP, analytics hashing and
    // Cloudinary signing) and the TCP sockets that the pg driver needs.
    "nodejs_compat",
    // Makes fetch() to our own hostname go back out through the edge rather than
    // looping inside the Worker, which is what OpenNext expects.
    "global_fetch_strictly_public"
  ],

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  // Lets the Worker call itself, which OpenNext uses for ISR revalidation.
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "maitrajewellery"
    }
  ],

  "observability": {
    "enabled": true
  }

  // ---------------------------------------------------------------------------
  // Hyperdrive (strongly recommended before taking real traffic)
  //
  // Without it, every request opens a brand-new Postgres connection to Supabase,
  // which is slow and will exhaust the connection limit under load. Create one:
  //
  //   npx wrangler hyperdrive create maitra-db \
  //     --connection-string="postgresql://USER:PASS@HOST:5432/postgres"
  //
  // then uncomment the block below with the returned id and redeploy.
  // lib/db.ts already prefers this binding when present.
  //
  // "hyperdrive": [
  //   { "binding": "HYPERDRIVE", "id": "<your-hyperdrive-id>" }
  // ]
  // ---------------------------------------------------------------------------
}
